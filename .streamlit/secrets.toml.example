# Copie este arquivo para .streamlit/secrets.toml (uso local) ou cole o
# conteudo em App settings > Secrets no Streamlit Cloud.

# "csv" (padrao, enquanto o backend nao esta pronto) ou "api"
DATA_SOURCE = "csv"

# Usado somente quando DATA_SOURCE = "api"
API_BASE_URL = "https://SEU-BACKEND.onrender.com"
